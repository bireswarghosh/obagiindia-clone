import React from 'react';
import { getSiteData } from '@/lib/db';
import Header from '@/components/Header';
import HeroMorph from '@/components/HeroMorph';
import TrustBanner from '@/components/TrustBanner';
import HistorySection from '@/components/HistorySection';
import AboutSection from '@/components/AboutSection';
import ResearchSection from '@/components/ResearchSection';
import CardStackSection from '@/components/CardStackSection';
import NewsletterSection from '@/components/NewsletterSection';
import Footer from '@/components/Footer';
import AskAiWidget from '@/components/AskAiWidget';

export const revalidate = 0; // Always serve fresh data upon admin publish

export default function HomePage() {
  const data = getSiteData();
  const { theme, header, hero, trustBanner, history, about, research, stickyCircle, cardsSection, newsletter, footer } = data;

  return (
    <main className="min-h-screen relative flex flex-col">
      {/* 1. Dynamic Header */}
      <Header header={header} theme={theme} />

      {/* 2. Hero Scroll Morph */}
      <HeroMorph hero={hero} theme={theme} />

      {/* 3. Physician Trust & Recommendations Banner */}
      <TrustBanner trust={trustBanner} theme={theme} />

      {/* 4. Our History & Awards Grid */}
      <HistorySection history={history} theme={theme} />

      {/* 5. About Obagi Medical */}
      <AboutSection about={about} theme={theme} />

      {/* 6. Research & Development (3 Lab Cards with Blur/Zoom Effects) */}
      <ResearchSection research={research} theme={theme} />

      {/* 7. 3D Perspective Card Stack + Expanding Pink Serum Background */}
      <CardStackSection
        cardsSection={cardsSection}
        stickyCircle={stickyCircle}
        theme={theme}
      />

      {/* 8. Functional Newsletter Subscription */}
      <NewsletterSection newsletter={newsletter} theme={theme} />

      {/* 9. Footer */}
      <Footer footer={footer} theme={theme} />

      {/* 10. Floating Interactive Obagi Clinical AI */}
      <AskAiWidget enabled={footer.askAiEnabled} theme={theme} />
    </main>
  );
}
